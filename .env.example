APP_ENV=local
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gold_track
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Wajib diisi di staging/production; di local ada fallback dev secret (jangan dipakai di prod)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY=24h

# Comma-separated list of origins allowed to call the API from a browser (default: * if unset)
CORS_ALLOWED_ORIGINS=*

# Dipakai oleh `go run ./cmd/seed` (opsional, ada default kalau tidak diisi)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@goldtrack.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_SHOP_NAME=Gold Track Store
SEED_SHOP_ADDRESS=Jl. Contoh No. 1, Jakarta
SEED_SHOP_PHONE=0800-0000-0000
